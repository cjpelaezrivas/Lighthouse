{
  "type": "commonjs",
  "name": "lighthouse",
  "version": "1.2.0",
  "description": "Lighthouse, site generator",
  "scripts": {
    "clean": "rimraf target",
    "typecheck": "tsc --p .",
    "compile": "tsc",
    "build": "npm run clean && npm run typecheck && npm run compile",
    "test": "npm run build && ./node_modules/.bin/jest --updateSnapshot",
    "start": "node ./target/app.js",
    "functional-test": "npm run build && npm run start -- ./tests/functional/test_site --debug && node ./tests/functional/functional_test.js"
  },
  "bin": {
    "lighthouse": "target/app.js"
  },
  "dependencies": {
    "@minify-html/node": "^0.15.0",
    "chalk": "4.1.2",
    "commander": "^13.1.0",
    "cross-env": "^7.0.3",
    "fs-extra": "^11.3.0",
    "highlight.js": "^11.6.0",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.1.6",
    "markdown-it-emoji": "2.0.2",
    "markdown-it-table-of-contents": "^0.9.0",
    "npm": "^11.0.0",
    "pretty": "^2.0.0",
    "rimraf": "^6.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.7",
    "husky": "^9.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.7.3"
  }
}
